{
  "name": "mod-manager",
  "private": true,
  "version": "0.5.11",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:app": "bash scripts/dev-app.sh",
    "dev:app:win": "PREVIEW_WINDOWS_CHROME=1 bash scripts/dev-app.sh",
    "build": "vite build",
    "app": "bash -c 'set -a && [ -f .env ] && . ./.env && set +a && npx tauri build --bundles app'",
    "app:dmg": "bash -c 'set -a && [ -f .env ] && . ./.env && set +a && export TAURI_SIGNING_PRIVATE_KEY_PASSWORD=${TAURI_SIGNING_PRIVATE_KEY_PASSWORD:-} && export CARGO_TARGET_DIR=$PWD/src-tauri/target && npx tauri build --bundles app,dmg'",
    "release:macos": "bash scripts/publish-local-macos-release.sh",
    "release:macos:fast": "SKIP_NPM_CI=1 bash scripts/publish-local-macos-release.sh",
    "release:macos:upload": "SKIP_BUILD=1 bash scripts/publish-local-macos-release.sh",
    "app:win": "tauri build --bundles nsis",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "github-markdown-css": "^5.9.0",
    "lucide-react": "^1.16.0",
    "marked": "^18.0.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-react": "^4.6.0",
    "vite": "^6.4.2"
  }
}
